VITE_API_BASE_URL=https://idenity.onrender.com

# ICP network host. Use https://icp0.io for mainnet or http://127.0.0.1:4943 for local dfx replica.
VITE_ICP_HOST=https://icp0.io

# ICRC-7 NFT canister ID. Empty until the canister is deployed.
VITE_ICP_NFT_CANISTER_ID=

# Payments canister (icp-local/) that prices mints and takes ICP via ICRC-2. Empty hides payments.
VITE_ICP_PAYMENTS_CANISTER_ID=
# Ledger used for payments. Default: ICP ledger. TESTICP on mainnet: xafvr-biaaa-aaaai-aql5q-cai
VITE_ICP_LEDGER_CANISTER_ID=ryjl3-tyaaa-aaaaa-aaaba-cai

# Firebase client API key (public, but keep out of source code)
VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# QR code base URL for printed NFC/QR deep-links (production viewer URL)
VITE_QR_BASE_URL=https://your-domain.github.io/idenity/
